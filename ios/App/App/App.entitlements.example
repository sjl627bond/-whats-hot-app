<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Add through Xcode only after the Apple Team ID, final Bundle ID, and owned domain are confirmed. -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:YOUR_OWNED_PRODUCTION_DOMAIN</string>
  </array>
  <!-- Xcode adds aps-environment when Push Notifications is enabled for the signed App ID. -->
</dict>
</plist>
