{
  "appId": "com.placeholder.gohott",
  "appName": "GoHott",
  "webDir": "www",
  "server": {
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#08080aff"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
